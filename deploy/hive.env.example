# One hive's settings for deploy/compose.yml. Copy to hive.env (never commit it) and fill in what you need.
# No secret belongs here: model keys, accounts and logins are made in the hive's own panel after it starts.

# The image: built here (docker build -t doca-hive .) or pulled from your private registry (deploy/README.md).
DOCA_HIVE_IMAGE=doca-hive:latest

# The hive's name: its container, volume and network are named after it.
HIVE_NAME=hive

# Where it answers. 127.0.0.1 keeps it to this machine (reach it through an SSH tunnel or the tailnet); a tailnet
# address publishes it there. The canvases' port must be HIVE_PORT + 1.
HIVE_BIND=127.0.0.1
HIVE_PORT=4310
HIVE_CANVAS_PORT=4311

# Limits, and gVisor when the machine has it (runsc), else runc.
HIVE_CPUS=2
HIVE_MEMORY=2g
HIVE_PIDS=512
HIVE_RUNTIME=runc

# This tailnet's MagicDNS suffix, when the hive is reached by a tailnet name (modules/toolbox/http.js "owned").
DOCA_TAILNET=
