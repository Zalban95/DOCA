{
  "name": "openclaw-dashboard",
  "version": "2.46.4",
  "description": "OpenClaw Panel — Web dashboard for managing the OpenClaw AI agent stack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "token": "node bin/doca-token.js",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.js\"",
    "openapi": "node -e \"process.stdout.write(JSON.stringify(require('./modules/api-v1/openapi').build(), null, 2) + '\\n')\"",
    "openapi:write": "node -e \"require('fs').writeFileSync('docs/api/openapi.json', JSON.stringify(require('./modules/api-v1/openapi').build(), null, 2) + '\\n')\"",
    "client:demo": "bash clients/reference/demo.sh"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
